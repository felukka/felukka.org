---
import { getCollection, render } from "astro:content";
import BlogPostLayout from "../../layouts/BlogPost.astro";
import WriterBadge from "../../components/react/WriterBadge.jsx";
import { writers } from "../../data/writers";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

const post = Astro.props;
const { Content, headings } = await render(post);

// Look up writer data if specified
const writerKey = post.data.writer as keyof typeof writers;
const writerData = writerKey ? writers[writerKey] : null;

// Only keep h2 and h3 headings for the ToC
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BlogPostLayout {...post.data}>
	<div class="w-full bg-surface px-6 lg:px-12 py-12 lg:py-20 relative">
		<div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-12 lg:gap-16 items-start">
			{/* LEFT COLUMN: Sticky Navigation */}
			<aside class="w-full lg:w-72 shrink-0 lg:sticky lg:top-24 flex flex-col gap-6">
				{/* Table of Contents */}
				<div class="bg-surface-container-low p-5 rounded-lg space-y-4">
					<div class="flex items-center justify-between">
						<span class="font-label text-xs font-bold uppercase tracking-widest text-primary flex items-center gap-2">
							<span class="material-symbols-outlined text-base">explore</span>
							On This Page
						</span>
						<span class="text-[10px] font-label text-outline uppercase tracking-wider">{tocHeadings.length} STOPS</span>
					</div>
					<nav class="flex flex-col space-y-1.5 font-label text-xs" id="tocNav">
						{tocHeadings.map((heading) => (
							<a class="toc-item flex items-center justify-between px-3 py-2 rounded bg-surface-container-high text-primary font-semibold transition-all hover:bg-surface-container" href={`#${heading.slug}`}>
								<span class="truncate">{heading.text}</span>
								{heading.depth === 2 && <span class="material-symbols-outlined text-xs">arrow_right</span>}
							</a>
						))}
					</nav>
				</div>
			</aside>

			{/* RIGHT COLUMN: Main Article */}
			<article class="w-full lg:flex-1 flex flex-col gap-12 font-body text-base lg:text-lg leading-relaxed text-on-surface-variant">
				<div id="post-content">
					<Content />
				</div>

				{/* Interactive code blocks */}
				<script>
					(function() {
						const container = document.getElementById('post-content');
						if (!container) return;

						container.querySelectorAll('pre > code').forEach(function(codeEl) {
							var pre = codeEl.parentElement;
							if (!pre || pre.classList.contains('code-block-wrapper')) return;

							var langMatch = codeEl.className.match(/language-(\w+)/);
							var language = langMatch ? langMatch[1] : '';
							var code = codeEl.textContent;

							var wrapper = document.createElement('div');
							wrapper.className = 'code-panel';
							wrapper.setAttribute('data-language', language);

							wrapper.innerHTML = '<div class="code-panel__header">' +
								'<div class="code-panel__meta">' +
									'<div class="code-panel__dots">' +
										'<span class="dot--red"></span>' +
										'<span class="dot--yellow"></span>' +
										'<span class="dot--green"></span>' +
									'</div>' +
									'<span class="code-panel__lang">' + (language.toUpperCase() || 'CODE') + '</span>' +
								'</div>' +
								'<button class="code-panel__copy">' +
									'<span class="material-symbols-outlined" style="font-size:14px">content_copy</span>' +
									'<span>COPY</span>' +
								'</button>' +
							'</div>' +
							'<div class="code-panel__body">' + pre.outerHTML + '</div>';

							var copyBtn = wrapper.querySelector('.code-panel__copy');
							copyBtn.addEventListener('click', function() {
								navigator.clipboard.writeText(code).then(function() {
									copyBtn.classList.add('copied');
									copyBtn.querySelector('.material-symbols-outlined').textContent = 'check';
									copyBtn.querySelector('span:last-child').textContent = 'COPIED';
									setTimeout(function() {
										copyBtn.classList.remove('copied');
										copyBtn.querySelector('.material-symbols-outlined').textContent = 'content_copy';
										copyBtn.querySelector('span:last-child').textContent = 'COPY';
									}, 2000);
								});
							});

							pre.remove();
							container.appendChild(wrapper);
						});
					})();
				</script>

				{/* Writer Badge */}
				{writerData && (
					<WriterBadge
						name={writerData.name}
						role={writerData.role}
						avatar={writerData.avatar}
						avatarColor={writerData.avatarColor}
						bio={writerData.bio}
						github={writerData.github}
						linkedin={writerData.linkedin}
					/>
				)}

				{/* Navigation */}
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
					<a class="bg-surface-container-low hover:bg-surface-container p-5 rounded-lg flex flex-col gap-2 group transition-all" href="/blog">
						<div class="flex items-center gap-1.5 text-xs font-label text-outline uppercase tracking-wider group-hover:text-primary transition-colors">
							<span class="material-symbols-outlined text-sm transition-transform group-hover:-translate-x-1">arrow_back</span>
							<span>Previous</span>
						</div>
						<span class="font-headline font-semibold text-sm lg:text-base text-on-surface group-hover:text-primary transition-colors">Next Post</span>
					</a>
					<a class="bg-surface-container-low hover:bg-surface-container p-5 rounded-lg flex flex-col gap-2 group transition-all text-right sm:items-end" href="/blog">
						<div class="flex items-center gap-1.5 text-xs font-label text-outline uppercase tracking-wider group-hover:text-primary transition-colors">
							<span>Next</span>
							<span class="material-symbols-outlined text-sm transition-transform group-hover:translate-x-1">arrow_forward</span>
						</div>
						<span class="font-headline font-semibold text-sm lg:text-base text-on-surface group-hover:text-primary transition-colors">Previous Post</span>
					</a>
				</div>
			</article>
		</div>
	</div>
</BlogPostLayout>

<style>
	.toc-item a[href^="#"]:not(.active) {
		color: var(--color-on-surface-variant, #c3c7ce);
	}
</style>
