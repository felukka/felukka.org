---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

// React Components
import ProjectCard from "../components/react/ProjectCard.jsx";
import BlogCard from "../components/react/BlogCard.jsx";
import CTASection from "../components/react/CTASection.jsx";

// Get latest blog posts
const allPosts = await getCollection("blog");
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Blog helper: read time
const getReadTime = (description: string) => {
  const words = description.split(" ").length;
  return Math.max(1, Math.ceil(words / 200));
};
---

<Layout title="Felukka">
  <main class="w-full pt-16 bg-surface flex-1">
    <div class="flex flex-col w-full text-on-surface">

      <!-- ========================================================
           HERO: Celestial Radar Bridge
           ======================================================== -->
      <section class="relative w-full overflow-hidden bg-surface pt-10 pb-20 lg:pt-16 lg:pb-28">
        {/* Ambient Celestial Radar Ring SVG Background */}
        <div class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-40">
          <svg class="w-[850px] h-[850px] lg:w-[1100px] lg:h-[1100px] -translate-y-12 animate-spin-slow" fill="none" viewBox="0 0 1000 1000">
            {/* Concentric Nautical Range Rings */}
            <circle cx="500" cy="500" opacity="0.6" r="160" stroke="#1d3f5e" strokeDasharray="4 6" stroke-width="1" />
            <circle cx="500" cy="500" opacity="0.5" r="300" stroke="#1d3f5e" strokeDasharray="2 8" stroke-width="1" />
            <circle cx="500" cy="500" opacity="0.3" r="430" stroke="#344b5e" strokeDasharray="8 12" stroke-width="1" />
            <circle cx="500" cy="500" opacity="0.25" r="480" stroke="#eac07d" strokeDasharray="1 16" stroke-width="1" />
            {/* Degree Ray Markers */}
            <line opacity="0.35" stroke="#1d3f5e" strokeDasharray="6 8" stroke-width="1" x1="500" x2="500" y1="50" y2="950" />
            <line opacity="0.35" stroke="#1d3f5e" strokeDasharray="6 8" stroke-width="1" x1="50" x2="950" y1="500" y2="500" />
            <line opacity="0.5" stroke="#161c22" stroke-width="1" x1="180" x2="820" y1="180" y2="820" />
            <line opacity="0.5" stroke="#161c22" stroke-width="1" x1="180" x2="820" y1="820" y2="180" />
            {/* North Star Cardinal Reticle */}
            <polygon fill="#eac07d" opacity="0.8" points="500,45 506,65 500,58 494,65" />
            <polygon fill="#b1c9e0" opacity="0.4" points="500,955 506,935 500,942 494,935" />
          </svg>
        </div>

        {/* Deep Sea Radial Ambient Glow */}
        <div class="absolute w-[600px] h-[600px] rounded-full bg-gradient-to-tr from-tertiary-container/20 via-primary/5 to-transparent blur-3xl pointer-events-none" />

        {/* Main Hero Content */}
        <div class="relative max-w-7xl mx-auto px-6 lg:px-12 flex flex-col items-start z-10">
          {/* Headline */}
          <h1 class="font-headline font-bold text-4xl sm:text-6xl lg:text-7xl tracking-tight text-on-surface leading-[1.08] max-w-4xl">
            Navigating Kubernetes with{" "}
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-primary-fixed to-secondary">
              Nautical Precision
            </span>
            .
          </h1>

          {/* Subheadline */}
          <p class="mt-6 font-body text-base sm:text-lg lg:text-xl text-on-surface-variant max-w-2xl leading-relaxed">
            An open-source collective engineering citizen-grade infrastructure instruments. Translating container topology and reconciling chaos into calm, actionable maritime command.
          </p>

          {/* CTA Row */}
          <div class="mt-8 sm:mt-10 flex flex-wrap items-center gap-4">
            <a class="group relative inline-flex items-center gap-2.5 px-6 py-3.5 rounded-md bg-primary hover:bg-primary-fixed-dim text-on-primary font-label text-sm font-semibold tracking-wider uppercase transition-all shadow-[0_0_24px_rgba(234,192,125,0.25)] hover:shadow-[0_0_32px_rgba(234,192,125,0.4)]" href="/services">
              <span class="material-symbols-outlined text-lg group-hover:rotate-12 transition-transform">explore</span>
              <span>Services</span>
            </a>
            <a class="group inline-flex items-center gap-2.5 px-6 py-3.5 rounded-md bg-surface-container-high hover:bg-surface-container-highest text-on-surface font-label text-sm font-semibold tracking-wider uppercase transition-all" href="#fleet">
              <span class="material-symbols-outlined text-lg group-hover:rotate-12 transition-transform">rocket_launch</span>
              <span>Projects</span>
            </a>
          </div>

        </div>
      </section>

      <!-- ========================================================
           SECTION 2: THE FLEET SHOWCASE
           ======================================================== -->
      <section class="w-full bg-surface-container-lowest py-20 lg:py-28" id="fleet">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
            <div class="space-y-2">
              <h2 class="font-headline text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-on-surface">
                PROJECTS
              </h2>
              <p class="font-body text-sm sm:text-base text-on-surface-variant max-w-2xl leading-relaxed">
                Citizen-grade cloud-native instruments crafted under the Felukka open-source umbrella. Autonomous operators, intelligent service mesh routing, and resilient state harbor backup working in concert.
              </p>
            </div>
            <div class="flex items-center gap-3">
              <span class="px-3 py-1.5 rounded-lg bg-surface-container-high text-xs font-label text-secondary uppercase tracking-wider font-medium">
                <span class="text-primary font-bold">3</span> Flagships Active
              </span>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-8" id="projects-grid">
            <!-- Koptan -->
            <ProjectCard
              icon="sailing"
              iconColor="#eac07d"
              iconBg="rgba(234,192,125,0.1)"
              category="Autonomous Operator"
              version="v1.4.2"
              versionColor="#eac07d"
              versionStatusColor="#eac07d"
              title="KOPTAN"
              subtitle="/ The Captain"
              subtitleColor="#eac07d"
              motif="Single-Sided Collapsible Oar Motif"
              description="The autonomous Kubernetes cluster captain. Handles self-healing deployment reconciliation, automated pod lifecycle captaincy, and CRD management with zero YAML toil. Enforces deterministic immutable states during network partitions."
              codeHeaderLeft="koptan.felukka.io/v1"
              codeStatus="Reconciled"
              codeCommand="$ kubectl get koptanroutes -A"
              codeOutput="helm-harbor-prod · 042.8° · 0.00% drift"
              tags={["Go / Operator SDK", "Custom CRDs", "Auto-Heal"]}
              ctaLabel="Source / GitHub"
              ctaHref="https://github.com/felukka/koptan"
              ctaColor="#eac07d"
              specLabel="CRD SPEC v1"
            />

            <!-- Bosla -->
            <ProjectCard
              icon="explore"
              iconColor="#b1c9e0"
              iconBg="rgba(177,201,224,0.1)"
              category="Service Mesh & Ingress"
              version="v0.9.4"
              versionColor="#b1c9e0"
              versionStatusColor="#b1c9e0"
              title="BOSLA"
              subtitle="/ The Compass"
              subtitleColor="#b1c9e0"
              motif="Waypointer & Traffic Astrolabe"
              description="Celestial traffic navigation and service mesh router across distributed clusters. Directs microservice requests with intelligent waypoint canary routing, seamless mutual TLS, and edge cluster ingress with zero-friction DNS management."
              codeHeaderLeft="bosla.felukka.io/v1beta"
              codeStatus="Routing Steady"
              codeCommand="$ bosla mesh route --azimuth=090"
              codeOutput="traffic: 80% stable · 20% canary-v2"
              tags={["eBPF / Envoy", "Canary Routing", "mTLS Native"]}
              ctaLabel="View Project / Docs"
              ctaHref="https://github.com/felukka/bosla"
              ctaColor="#b1c9e0"
              specLabel="ROUTER v0.9"
            />

            <!-- Kara -->
            <ProjectCard
              icon="anchor"
              iconColor="#eac07d"
              iconBg="rgba(234,192,125,0.1)"
              category="State & Snapshot"
              version="v2.0.1"
              versionColor="#eac07d"
              versionStatusColor="#eac07d"
              title="KARA"
              subtitle="/ The Anchor"
              subtitleColor="#eac07d"
              motif="Harbor Ledger & Immutable Store"
              description="The harbor bedrock securing persistent volume storage and state resilience. Guarantees deterministic cluster snapshotting, seamless disaster recovery, and cryptographically verified state ledgers across cloud and bare-metal harbors."
              codeHeaderLeft="kara.felukka.io/v1"
              codeStatus="Snapshot Sync"
              codeCommand="$ kara harbor snap --immutable"
              codeOutput="pvc-ledger-snap-084 [SHA-256 OK]"
              tags={["CSI Plugin", "Immutable Snapshots", "Disaster Recovery"]}
              ctaLabel="Explore Ledger"
              ctaHref="https://github.com/felukka/kara"
              ctaColor="#eac07d"
              specLabel="CSI SPEC v2"
            />
          </div>
        </div>
      </section>

      <!-- ========================================================
           SECTION 4: THE LOGBOOK / BLOG PREVIEW
           ======================================================== -->
      <section class="w-full bg-surface-container-lowest py-20 lg:py-28">
        <div class="max-w-7xl mx-auto px-6 lg:px-12">
          {/* Section Header */}
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
            <div class="space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-primary" />
                <span class="font-label text-xs uppercase tracking-widest text-primary font-semibold">Signal Dispatches</span>
              </div>
              <h2 class="font-headline text-3xl sm:text-4xl font-bold tracking-tight text-on-surface">THE LOGBOOK</h2>
              <p class="font-body text-sm text-on-surface-variant">Engineering dispatches, navigational charts, and release logs from our core maintainers.</p>
            </div>
            <a class="inline-flex items-center gap-1.5 text-xs font-label uppercase tracking-widest text-secondary hover:text-on-surface transition-colors font-semibold" href="/blog">
              <span>Browse All Dispatches</span>
              <span class="material-symbols-outlined text-base">arrow_forward</span>
            </a>
          </div>

          {/* Blog Cards Grid */}
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {latestPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                category={post.data.category || "OBSERVABILITY"}
                categoryBg="#1d3f5e"
                categoryText="#a9c9ef"
                pubDate={post.data.pubDate.toLocaleDateString("en-US", { month: "short", year: "numeric" }).toUpperCase()}
                readTime={getReadTime(post.data.description)}
                href={`/blog/${post.id}`}
                tags={post.data.tags || []}
                authorName={post.data.author || "Maintainer"}
                authorInitial={post.data.author?.[0] || "M"}
                authorColor="#eac07d"
              />
            ))}
          </div>
        </div>
      </section>

      <!-- ========================================================
           SECTION 5: COMMUNITY & JOIN THE BRIDGE CTA
           ======================================================== -->
      <CTASection
        title="Ready to Embark?"
        description="Whether you are piloting five microservices or commanding thousands of high-velocity nodes across continents, the Felukka constellation is built for your bridge."
        primaryCTA={{ label: "Star Felukka on GitHub", href: "https://github.com/felukka" }}
        secondaryCTA={{ label: "Read Quickstart Guide", href: "https://docs.felukka.org" }}
        tertiaryCTA={{ label: "Join Discord Bridge", href: "https://discord.gg/Rzt9NM7RK5" }}
      />

    </div>
  </main>
</Layout>
