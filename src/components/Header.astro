---
const { activePath = "overview" } = Astro.props;
---

<header class="fixed top-0 w-full z-50 bg-surface/85 backdrop-blur-xl shadow-header">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <!-- Desktop: Logo + Nav + spacer -->
    <div class="hidden md:flex items-center justify-between h-14">
      <a class="flex items-center gap-2 group" data-path="overview" href="/">
        <span class="material-symbols-outlined text-primary text-2xl transition-transform duration-300 group-hover:rotate-45">explore</span>
        <span class="font-headline font-bold text-sm lg:text-base tracking-wider text-on-surface uppercase">FELUKKA</span>
      </a>
      <nav class="flex items-center gap-1 lg:gap-2" data-active-classes="bg-surface-container text-on-surface font-semibold rounded-lg">
        <a class="px-3 py-1.5 rounded-lg text-sm font-label tracking-wide text-on-surface-variant hover:text-on-surface transition-colors {@activePath === 'overview' ? 'bg-surface-container text-on-surface font-semibold rounded-lg' : ''}" data-path="overview" href="/">Deck</a>
        <a class="px-3 py-1.5 rounded-lg text-sm font-label tracking-wide text-on-surface-variant hover:text-on-surface transition-colors {@activePath === 'projects' ? 'bg-surface-container text-on-surface font-semibold rounded-lg' : ''}" data-path="projects" href="/#fleet">Projects</a>
        <a class="px-3 py-1.5 rounded-lg text-sm font-label tracking-wide text-on-surface-variant hover:text-on-surface transition-colors {@activePath === 'blog' ? 'bg-surface-container text-on-surface font-semibold rounded-lg' : ''}" data-path="blog" href="/blog">Blog</a>
        <a class="px-3 py-1.5 rounded-lg text-sm font-label tracking-wide text-on-surface-variant hover:text-on-surface transition-colors {@activePath === 'services' ? 'bg-surface-container text-on-surface font-semibold rounded-lg' : ''}" data-path="services" href="/services">Services</a>
        <a class="px-3 py-1.5 rounded-lg text-sm font-label tracking-wide text-on-surface-variant hover:text-on-surface transition-colors {@activePath === 'about' ? 'bg-surface-container text-on-surface font-semibold rounded-lg' : ''}" data-path="about" href="/about">About</a>
      </nav>
      <div class="w-32" />
    </div>

    <!-- Mobile: Single row - Logo + Nav -->
    <div class="flex md:hidden items-center justify-between h-14">
      <a class="flex items-center gap-2 group" data-path="overview" href="/">
        <span class="material-symbols-outlined text-primary text-2xl transition-transform duration-300 group-hover:rotate-45">explore</span>
        <span class="font-headline font-bold text-sm lg:text-base tracking-wider text-on-surface uppercase">FELUKKA</span>
      </a>
      <nav class="flex items-center gap-1 overflow-x-auto no-scrollbar">
        <a class="px-2.5 py-1.5 rounded-lg text-xs font-label tracking-wide text-on-surface-variant hover:text-on-surface transition-colors whitespace-nowrap {@activePath === 'overview' ? 'bg-surface-container text-on-surface font-semibold rounded-lg' : ''}" data-path="overview" href="/">Deck</a>
        <a class="px-2.5 py-1.5 rounded-lg text-xs font-label tracking-wide text-on-surface-variant hover:text-on-surface transition-colors whitespace-nowrap {@activePath === 'projects' ? 'bg-surface-container text-on-surface font-semibold rounded-lg' : ''}" data-path="projects" href="/#fleet">Projects</a>
        <a class="px-2.5 py-1.5 rounded-lg text-xs font-label tracking-wide text-on-surface-variant hover:text-on-surface transition-colors whitespace-nowrap {@activePath === 'blog' ? 'bg-surface-container text-on-surface font-semibold rounded-lg' : ''}" data-path="blog" href="/blog">Blog</a>
        <a class="px-2.5 py-1.5 rounded-lg text-xs font-label tracking-wide text-on-surface-variant hover:text-on-surface transition-colors whitespace-nowrap {@activePath === 'services' ? 'bg-surface-container text-on-surface font-semibold rounded-lg' : ''}" data-path="services" href="/services">Services</a>
        <a class="px-2.5 py-1.5 rounded-lg text-xs font-label tracking-wide text-on-surface-variant hover:text-on-surface transition-colors whitespace-nowrap {@activePath === 'about' ? 'bg-surface-container text-on-surface font-semibold rounded-lg' : ''}" data-path="about" href="/about">About</a>
      </nav>
    </div>
  </div>
</header>
