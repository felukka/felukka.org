          <a class="text-xs text-on-surface-variant hover:text-on-surface transition-colors" data-path="logbook" href="/blog">Posts</a>
          <a class="text-xs text-on-surface-variant hover:text-on-surface transition-colors" data-path="logbook" href="/blog">RSS Feed</a>
        </div>
        <div class="flex flex-col space-y-2">
          <span class="font-label text-xs font-semibold tracking-widest uppercase text-on-surface">Links</span>
          <a class="text-xs text-on-surface-variant hover:text-on-surface transition-colors" href="https://github.com/felukka" rel="noreferrer" target="_blank">GitHub</a>
          <a class="text-xs text-on-surface-variant hover:text-on-surface transition-colors" href="https://www.linkedin.com/company/felukka" rel="noreferrer" target="_blank">LinkedIn</a>
