<footer class="w-full bg-surface-container-low pt-14 pb-10">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <!-- Top Grid -->
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-8 pb-10">
      <!-- Brand Column -->
      <div class="space-y-3 max-w-md">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-xl">sailing</span>
          <span class="font-headline font-semibold text-sm tracking-wider uppercase text-on-surface">FELUKKA</span>
        </div>
        <p class="text-xs text-on-surface-variant font-body leading-relaxed">
          Citizen-grade cloud-native navigation for Kubernetes clusters. Autonomous telemetry orchestration, high-visibility operator controls, and transparent celestial telemetry.
        </p>

      </div>

      <!-- Link Columns -->
      <div class="flex flex-wrap gap-12">
        <div class="flex flex-col space-y-2">
          <span class="font-label text-xs font-semibold tracking-widest uppercase text-on-surface">Projects</span>
          <a class="text-xs text-on-surface-variant hover:text-on-surface transition-colors" data-path="fleet-projects" href="https://koptan.felukka.org">Koptan</a>
          <a class="text-xs text-on-surface-variant hover:text-on-surface transition-colors" data-path="fleet-projects" href="https://bosla.felukka.org">Bosla</a>
