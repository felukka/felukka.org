---
import Layout from "./Layout.astro";
import type { CollectionEntry } from "astro:content";

const { title, description, pubDate, updatedDate, category = "OBSERVABILITY" } =
  Astro.props as unknown as CollectionEntry<"blog">["data"];

const formattedDate = pubDate.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

const readTime = Math.max(1, Math.ceil(description.split(" ").length / 200));
---

<Layout title="Felukka">
  <div class="flex flex-col w-full text-on-surface">
    {/* Top Atmospheric Horizon Line */}
    <div class="w-full h-0.5 bg-gradient-to-r from-tertiary-container via-primary to-transparent opacity-80" />

    {/* Editorial Masthead / Header Section */}
    <section class="w-full bg-surface-container-lowest px-6 lg:px-12 py-10 lg:py-16 relative overflow-hidden">
      {/* Ambient Glow */}
      <div class="pointer-events-none absolute -top-32 right-10 w-96 h-96 rounded-full bg-tertiary-container/15 blur-3xl" />
      <div class="pointer-events-none absolute -bottom-20 left-1/4 w-80 h-80 rounded-full bg-primary/5 blur-3xl" />

      <div class="max-w-7xl mx-auto relative z-10 flex flex-col gap-6">
        {/* Breadcrumb */}
        <div class="flex flex-wrap items-center justify-between gap-4 text-xs font-label uppercase tracking-widest text-on-surface-variant">
          <div class="flex items-center gap-2">
            <a class="hover:text-primary transition-colors flex items-center gap-1.5 text-secondary" href="/blog">
              <span class="material-symbols-outlined text-sm">arrow_back</span>
              <span>Back to all dispatches</span>
            </a>
            <span class="text-outline-variant opacity-40">/</span>
            <span class="text-on-surface-variant">Logbook</span>
            <span class="text-outline-variant opacity-40">/</span>
            <span class="text-on-surface-variant">{category.split("·")[0]?.trim()}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded bg-surface-container-high text-primary text-[10px] tracking-widest font-semibold">
              <span class="material-symbols-outlined text-xs">radar</span> DISPATCH
            </span>
            <span class="hidden sm:inline-block text-[11px] text-outline">ASTRO v7 + TS 5.4</span>
          </div>
        </div>

        {/* Category Pill & Metadata */}
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <span class="px-3 py-1 rounded bg-secondary-container/50 text-secondary text-xs font-label tracking-widest uppercase font-semibold">
            {category}
          </span>
          <span class="text-xs text-on-surface-variant font-label flex items-center gap-1.5">
            <span class="material-symbols-outlined text-xs text-primary">calendar_today</span>
            {formattedDate}
          </span>
          <span class="text-xs text-on-surface-variant font-label flex items-center gap-1.5">
            <span class="material-symbols-outlined text-xs text-primary">schedule</span>
            {readTime} min read
          </span>
        </div>

        {/* Headline */}
        <div class="flex items-start justify-between gap-4">
          <h1 class="font-headline font-bold text-3xl sm:text-4xl lg:text-5xl text-on-surface tracking-tight leading-[1.15] max-w-5xl">
            {title}
          </h1>
          <button
            id="copy-link-btn"
            class="shrink-0 px-3 py-1.5 rounded bg-surface-container hover:bg-surface-container-high text-secondary hover:text-on-surface font-label text-xs uppercase tracking-wider transition-colors flex items-center gap-1.5"
            onclick="navigator.clipboard.writeText(window.location.href); const btn = document.getElementById('copy-link-btn'); btn.classList.add('bg-primary', 'text-on-primary'); btn.querySelector('span:last-child').textContent = 'Copied!'; setTimeout(() => { btn.classList.remove('bg-primary', 'text-on-primary'); btn.querySelector('span:last-child').textContent = 'Copy Link'; }, 2000);"
          >
            <span class="material-symbols-outlined text-sm">link</span>
            <span>Copy Link</span>
          </button>
        </div>

        {/* Lede */}
        <p class="font-body text-base lg:text-xl text-on-surface-variant leading-relaxed max-w-4xl font-normal">
          {description}
        </p>
      </div>
    </section>

    {/* Main Content */}
    <slot />
  </div>
</Layout>
